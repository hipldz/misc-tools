        {
          "id": "intro-01",
          "text": "同一张图，可以只放着让人看，也可以沿着解释逐步聚焦。"
        },
        {
          "id": "intro-02",
          "text": "这段示例用一组明确标注的示意数据，展示两种镜头。"
        }
      ]
    }
  },
  {
    "id": "source",
    "category": "聚焦",
    "narration": {
      "segments": [
        {
          "id": "source-01",
          "text": "先看全图，确认比较的是同一个任务，以及相同范围内的用时。"
        },
        {
          "id": "source-02",
          "text": "再聚焦最后一根柱子：示意用时从三十秒降到了十二秒。"
        },
        {
          "id": "source-03",
          "text": "变化看清了，但这张图本身，还不能证明具体是怎样节省时间的。"
        }
      ]
    }
  },
  {
    "id": "pipeline",
    "category": "同步",
    "narration": {
      "segments": [
        {
          "id": "pipeline-01",
          "text": "本项目的运行时按照当前时间，找到对应的旁白句子和场景。"
        },
        {
          "id": "pipeline-02",
          "text": "把一个镜头绑定到这些句子的编号，画面就能在解释到这里时出现。"
        }
      ]
    }
  },
  {
    "id": "outro",
    "category": "应用",
    "narration": {
      "segments": [
        {
          "id": "outro-01",
          "text": "制作真实报道时，把示意图换成原始图表或实际演示。"
        },
        {
          "id": "outro-02",
          "text": "再用局部、对照和结果，解释关键细节。"
        },
        {
          "id": "outro-03",
          "text": "让观众看见依据，解说才有具体的东西可讲。"
        }
      ]
    }
  }
]
